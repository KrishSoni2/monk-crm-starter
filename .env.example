# ------------------------------------------------------------
# Copy this file to .env and fill in the values.
# .env is ignored by git. Never commit it, never share it.
# Every variable is explained in docs/CONNECTIONS.md.
# ------------------------------------------------------------

# REQUIRED. Your PostgreSQL connection string.
# Local dev: Railway > Postgres service > Variables > DATABASE_PUBLIC_URL (copy its value here).
# On Railway: set DATABASE_URL to ${{Postgres.DATABASE_URL}} (the private network address).
DATABASE_URL=

# REQUIRED IN PRODUCTION. The one password your team uses to sign in.
# Left empty locally, the app is open and shows a warning banner.
# Left empty on Railway, the app stays locked until you set it.
APP_PASSWORD=

# OPTIONAL. Calendly personal access token. Without it the app runs on demo data.
# Calendly > Integrations & apps > API & webhooks > Personal access tokens.
CALENDLY_TOKEN=

# OPTIONAL. A long random string that protects /api/sync (used by the 15-minute cron).
# Make one with: npm run secret
SYNC_SECRET=

# OPTIONAL, PAID CALENDLY PLANS ONLY. Turns on instant webhook updates.
# Make one with: npm run secret, then run `npm run calendly:webhook -- create`.
CALENDLY_WEBHOOK_SIGNING_KEY=

# OPTIONAL. Your app's public address, e.g. https://your-app.up.railway.app
# Used by the webhook registration script and the cron job.
APP_URL=

# OPTIONAL. Only for `npm test`: a SECOND, empty database for the database tests.
# The tests erase everything in it, so NEVER use your real DATABASE_URL here.
# Leave empty to skip the database tests (the other tests still run).
TEST_DATABASE_URL=
